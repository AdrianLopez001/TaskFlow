{
  "compilerOptions": {
    "target": "ES2022",
    "module": "None",       // Usamos None ou ESNext. Como estamos rodando direto no navegador sem bundler (Vite/Webpack), None compila tudo sem imports/exports que causariam erros CORS locais.
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
